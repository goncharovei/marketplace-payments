# ============================================================
#  Marketplace Payments — Environment Configuration
# ============================================================
#  Copy this file to .env and fill in real values:
#      cp .env.example .env
# ============================================================

# ---------- PostgreSQL: Order Service ----------
ORDER_DB_DATABASE=order_db
ORDER_DB_USERNAME=order_user
ORDER_DB_PASSWORD=change_me_order

# ---------- PostgreSQL: Payment Service ----------
PAYMENT_DB_DATABASE=payment_db
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=change_me_payment

# ---------- PostgreSQL: Payout Service ----------
PAYOUT_DB_DATABASE=payout_db
PAYOUT_DB_USERNAME=payout_user
PAYOUT_DB_PASSWORD=change_me_payout

# ---------- RabbitMQ ----------
RABBITMQ_USER=mp_user
RABBITMQ_PASSWORD=change_me_rabbitmq
